# Copy this file to `.env` and fill in real values.
#
# RADICALE_USER / RADICALE_PASSWORD are the only variables `compose.yaml`
# interpolates (into the `caldir` service's environment, as
# RADICALE_USER/RADICALE_PASSWORD, and used by caldir to authenticate against
# the `radicale` service). The user must already exist in
# `radicale/config/users`, an htpasswd file (gitignored, created by hand —
# see docs/operations.md#radicale-users).
RADICALE_USER=changeme
RADICALE_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Script defaults that can be overridden — NOT read by compose today; adding
# them requires editing `caldir.environment` in compose.yaml
# ---------------------------------------------------------------------------
#
# These variables are read directly by caldir/provision-google.py,
# caldir/bridge-vtodo.py and caldir/bridge-windows.py when those scripts run
# inside the caldir container. Setting them here has no effect until
# compose.yaml's `caldir.environment` block passes them through. Values below
# are each script's in-code default (GOOGLE_ACCOUNT excepted: its real
# default is a personal address baked into provision-google.py and is never
# reproduced here).
#
# GOOGLE_ACCOUNT=you@example.com
# GOOGLE_UNAB_TASKLIST_NAME=UNAB
# GOOGLE_UNAB_TASKLIST_SLUG=unab
# GOOGLE_UNAB_WINDOWS_CALENDAR=UNAB - Ventanas de entrega
# GOOGLE_UNAB_WINDOWS_SLUG=unab-windows
# CALENDAR_ROOT=/data/calendars
# GOOGLE_TASKS_DIR=/data/calendars/unab
# GOOGLE_WINDOWS_DIR=/data/calendars/unab-windows
# BRIDGE_STATE_FILE=/data/.local/share/caldir/vtodo-bridge-state.json
# WINDOWS_BRIDGE_STATE_FILE=/data/.local/share/caldir/windows-bridge-state.json
#
# Google OAuth client credentials (client_id/client_secret) are never set via
# environment variables. They live in
# caldir/config/providers/google/app_config.toml (gitignored), read directly
# by provision-google.py.
